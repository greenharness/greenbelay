# amont-agent-cases-v1
# Reviewed judgements for this rule. Generated by
#   amont-agent explain <rule> --format cases
# then labelled by hand. `amont-agent corpus check` replays every line through
# the rules as they stand today, and runs as a test — so widening a rule in a
# way that breaks a judgement somebody already made is a red build.
#
# match   the rule SHOULD fire here
# nomatch the rule must stay silent here — these are the ones that matter,
#         because a corpus of positives alone measures recall, not precision
# ?       nobody has looked yet; never counts as evidence
#
# The first match is the 2026-11-25 call that closed every Ghostty tab but
# the caller's: `-n` after the pattern was a second pattern on BSD pkill.

# --- the rule should fire ---
match	pkill -f "react-router-serve.*" -n 2>/dev/null; lsof -ti :24101 | xargs kill; sleep 1; lsof -i :24101 -i :24102 -i :24100 | awk '{print $1,$9}'
match	pgrep -f "storybook dev" -l
match	pkill -9 -f vite -x
match	sudo pkill -f 'storybook dev' -n

# --- the rule must stay silent ---
nomatch	pkill -f "cargo test -q --workspace --features relais/conformance"; sleep 2; pgrep -fl "workspace --features relais" | head -3
nomatch	pkill -f "make plugin"; cd /Users/fredericrous/Developer/Perso/relais-wt-f21 && make plugin > /tmp/f21-run3.log 2>&1
nomatch	pkill -f "storybook dev -p 6713"; pkill -f "storybook dev -p 6714"; sleep 1; pgrep -fl "storybook dev -p 671[34]" || echo stopped
nomatch	pkill -f "until ! pgrep" ; pgrep -x npm
nomatch	pkill -n -f "react-router-serve"
nomatch	pkill -TERM -f 'make plugin'
nomatch	pgrep -u root -lf sshd
nomatch	pkill chrome
nomatch	grep -rn 'pkill -f x -n' docs/
